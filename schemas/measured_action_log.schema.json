{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One measured randomized development action used for policy fit or held-out OPE",
  "type": "object",
  "required": [
    "event_id",
    "image_id",
    "specimen_id",
    "split",
    "is_synthetic",
    "features",
    "action",
    "available_actions",
    "propensity",
    "logging_policy_probs",
    "cost_minutes",
    "quoted_max_cost_minutes",
    "reward",
    "reward_source_split",
    "reward_specimen_ids"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "image_id": {
      "type": "string",
      "minLength": 1
    },
    "specimen_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "policy_train",
        "policy_val"
      ]
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "action": {
      "enum": [
        "new_image",
        "boundary",
        "missing",
        "class",
        "review",
        "reimage"
      ]
    },
    "available_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "new_image",
          "boundary",
          "missing",
          "class",
          "review",
          "reimage"
        ]
      }
    },
    "propensity": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "logging_policy_probs": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "cost_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quoted_max_cost_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quote_overrun_minutes": {
      "type": "number",
      "minimum": 0
    },
    "reward": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "reward_source_split": {
      "const": "reward"
    },
    "reward_specimen_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$comment": "Semantic validation checks complete logging probabilities, exact propensity, public feature allowlist and independently measured rewards. Human completion without measured reward is not a learning log."
}
